# Copie este arquivo para `.env` e preencha com os valores do seu projeto Firebase.
# Os valores ficam fora do controle de versao (o `.env` esta no .gitignore).
# Eles sao lidos pelo script `scripts/gerar-firebase-config.mjs`, que gera
# `src/environments/firebase-config.ts` antes de compilar/servir.

NG_APP_FIREBASE_API_KEY=sua-api-key
NG_APP_FIREBASE_AUTH_DOMAIN=seu-projeto.firebaseapp.com
NG_APP_FIREBASE_PROJECT_ID=seu-projeto
NG_APP_FIREBASE_STORAGE_BUCKET=seu-projeto.firebasestorage.app
NG_APP_FIREBASE_MESSAGING_SENDER_ID=000000000000
NG_APP_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000

# Credenciais do admin, usadas apenas por scripts/backfill-lider.mjs (rode uma vez
# antes de aplicar as Firestore Rules que dependem do campo `lider`).
ADMIN_EMAIL=admin@exemplo.com
ADMIN_PASSWORD=sua-senha-admin
